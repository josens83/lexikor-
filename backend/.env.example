# LexiKor Backend Environment Configuration
# Copy this file to .env and fill in the values

# ================================
# APPLICATION
# ================================
APP_NAME=LexiKor
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ================================
# API
# ================================
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ================================
# CORS & SECURITY
# ================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://lexikor.ai,https://www.lexikor.ai,https://app.lexikor.ai
ALLOWED_HOSTS=lexikor.ai,www.lexikor.ai,app.lexikor.ai
FRONTEND_URL=https://app.lexikor.ai

# ================================
# DATABASE - PostgreSQL
# ================================
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/lexikor_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# ================================
# REDIS
# ================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ================================
# VECTOR DATABASE - Pinecone
# ================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=lexikor-legal-docs

# ================================
# ELASTICSEARCH
# ================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ================================
# LLM APIs
# ================================
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# ================================
# AWS (for S3 document storage)
# ================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=lexikor-documents

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# OAUTH (Optional)
# ================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ================================
# PAYMENT - Stripe
# ================================
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ================================
# PAYMENT - Toss Payments (Korean)
# ================================
TOSS_CLIENT_KEY=live_ck_...
TOSS_SECRET_KEY=live_sk_...
TOSS_WEBHOOK_SECRET=

# ================================
# EMAIL - SendGrid
# ================================
SENDGRID_API_KEY=SG...
FROM_EMAIL=noreply@lexikor.ai
ADMIN_EMAIL=admin@lexikor.ai

# ================================
# MONITORING - Sentry
# ================================
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=2000

# ================================
# FILE UPLOAD
# ================================
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.hwp,.txt
UPLOAD_DIR=/var/lexikor/uploads

# ================================
# OCR
# ================================
TESSERACT_PATH=/usr/bin/tesseract
USE_AWS_TEXTRACT=False

# ================================
# CELERY (Background Tasks)
# ================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ================================
# FEATURE FLAGS
# ================================
ENABLE_ENTERPRISE_FEATURES=True
ENABLE_API_ACCESS=True
ENABLE_MOBILE_APP=False

# ================================
# SECURITY
# ================================
ENABLE_HTTPS=True
ENABLE_CORS=True
ENABLE_MFA=True

# ================================
# SUBSCRIPTION PLANS (in KRW)
# ================================
FREE_PLAN_QUERY_LIMIT=20
PRO_PLAN_MONTHLY_PRICE=99000
ENTERPRISE_MIN_SEATS=10
